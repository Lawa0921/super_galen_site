---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="商隊議事會｜商隊與劍" description="隊伍化學反應與商隊議事會。">
  <main class="shell">
    <p class="eyebrow">CARAVAN &amp; SWORD · M32</p>
    <h1>商隊議事會</h1>
    <p>隊伍化學反應功能正在載入。</p>
    <p><a href="/caravan/play">返回遊戲</a></p>
  </main>
</BaseLayout>

<style>
  :global(body) { background: #12100d; color: #eee5d2; }
  .shell { width: min(760px, calc(100% - 28px)); margin: 0 auto; padding: 56px 0; }
  .eyebrow { color: #c7a464; letter-spacing: .16em; }
  a { color: #dfbf7d; }
</style>
