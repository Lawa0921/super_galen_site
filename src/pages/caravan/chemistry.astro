---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="商隊議事會｜商隊與劍" description="以命運、職涯與羈絆分析隊伍化學反應，召開不可重複的商隊議事會。">
  <main class="chemistry-shell">
    <header class="hero">
      <p class="eyebrow">CARAVAN &amp; SWORD · M32</p>
      <h1>商隊議事會</h1>
      <p>選擇 2～4 名健康成員。不同出身、職涯互補、共同經歷與缺陷衝突會形成公開可驗證的隊伍化學反應。</p>
      <nav>
        <a href="/caravan/play">返回遊戲</a>
        <a href="/caravan/companions">旅伴身世</a>
        <a href="/caravan/dossier">商隊檔案</a>
      </nav>
    </header>

    <section id="empty" class="panel" hidden>
      <h2>找不到商隊存檔</h2>
      <p>先建立旅程並招募旅伴，再回來召開議事會。</p>
      <a class="primary-link" href="/caravan/forge">前往命運鍛造所</a>
    </section>

    <div id="app" hidden>
      <section class="panel">
        <div class="section-head">
          <div>
            <p class="eyebrow">MEMBERS</p>
            <h2>參與成員</h2>
          </div>
          <p id="selection-count" class="counter"></p>
        </div>
        <p class="hint">隊長固定參與；其他旅伴可自由組合。傷員暫時不能參加。</p>
        <div id="members" class="member-grid"></div>
      </section>

      <section class="panel result-panel">
        <div class="score-orb">
          <strong id="score">0</strong>
          <span id="grade">穩定</span>
        </div>
        <div class="result-copy">
          <p class="eyebrow">CHEMISTRY</p>
          <h2 id="council-title">第 1 次正式議事會</h2>
          <p id="summary"></p>
          <div class="metrics">
            <span>成本 <b id="cost">0 G</b></span>
            <span>旅伴羈絆 <b id="reward">+0</b></span>
          </div>
        </div>
      </section>

      <section class="panel">
        <div class="section-head">
          <div>
            <p class="eyebrow">BREAKDOWN</p>
            <h2>正負因素</h2>
          </div>
        </div>
        <div id="factors" class="factor-list"></div>
        <div id="blockers" class="blockers" hidden></div>
        <button id="conduct" type="button">召開議事會</button>
        <p id="message" class="message" aria-live="polite"></p>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { JOBS } from '@scripts/games/caravan/data/jobs';
  import { SAVE_KEY, loadGame, saveGame } from '@scripts/games/caravan/save';
  import {
    chemistryMemberDescription,
    conductTeamCouncil,
    teamChemistryProfile,
  } from '@scripts/games/caravan/data/teamChemistry';

  const emptyEl = document.getElementById('empty')!;
  const appEl = document.getElementById('app')!;
  const membersEl = document.getElementById('members')!;
  const countEl = document.getElementById('selection-count')!;
  const scoreEl = document.getElementById('score')!;
  const gradeEl = document.getElementById('grade')!;
  const titleEl = document.getElementById('council-title')!;
  const summaryEl = document.getElementById('summary')!;
  const costEl = document.getElementById('cost')!;
  const rewardEl = document.getElementById('reward')!;
  const factorsEl = document.getElementById('factors')!;
  const blockersEl = document.getElementById('blockers')!;
  const conductButton = document.getElementById('conduct') as HTMLButtonElement;
  const messageEl = document.getElementById('message')!;

  let save = loadGame();
  let selected = new Set<string>();

  function text(tag: string, value: string, className?: string): HTMLElement {
    const element = document.createElement(tag);
    if (className) element.className = className;
    element.textContent = value;
    return element;
  }

  function initializeSelection(): void {
    if (!save) return;
    const requested = save.expeditionPlan?.activeIds ?? [
      save.protagonist.id,
      ...save.companions.filter((companion) => companion.injuredForTrips === 0).map((companion) => companion.id),
    ];
    selected = new Set([save.protagonist.id]);
    for (const id of requested) {
      if (selected.size >= 4) break;
      if (id === save.protagonist.id) continue;
      const companion = save.companions.find((record) => record.id === id && record.injuredForTrips === 0);
      if (companion) selected.add(id);
    }
  }

  function renderMembers(): void {
    if (!save) return;
    membersEl.replaceChildren();
    const roster = [save.protagonist, ...save.companions];
    for (const record of roster) {
      const label = document.createElement('label');
      label.className = 'member-card';
      if (record.injuredForTrips > 0) label.classList.add('injured');
      const input = document.createElement('input');
      input.type = 'checkbox';
      input.checked = selected.has(record.id);
      input.disabled = record.id === save.protagonist.id || record.injuredForTrips > 0;
      input.addEventListener('change', () => {
        if (input.checked) {
          if (selected.size >= 4) {
            input.checked = false;
            messageEl.textContent = '議事會最多四人。';
            return;
          }
          selected.add(record.id);
        } else {
          selected.delete(record.id);
        }
        render();
      });

      const body = document.createElement('div');
      body.append(
        text('strong', `${record.name} · ${JOBS[record.job].name}`),
        text('span', record.id === save.protagonist.id ? '隊長｜固定參與' : `羈絆 ${record.bond ?? 0}`),
        text(
          'small',
          record.injuredForTrips > 0
            ? `養傷中，剩餘 ${record.injuredForTrips} 趟`
            : record.genesis && record.growth
              ? chemistryMemberDescription({
                  id: record.id,
                  name: record.name,
                  isProtagonist: record.id === save.protagonist.id,
                  registered: true,
                  lifepathId: record.genesis.lifepathId,
                  aptitudeId: record.genesis.aptitudeId,
                  burdenId: record.genesis.burdenId,
                  latestCareerId: record.careerMilestones?.slice().sort((a, b) => b.level - a.level)[0]?.pathId ?? null,
                  bond: record.bond ?? 0,
                  bondTier: 0,
                })
              : '身世尚未登記',
        ),
      );
      label.append(input, body);
      membersEl.append(label);
    }
  }

  function render(): void {
    if (!save) return;
    renderMembers();
    const profile = teamChemistryProfile(save, [...selected]);
    countEl.textContent = `${selected.size} / 4 人`;
    scoreEl.textContent = profile.score > 0 ? `+${profile.score}` : String(profile.score);
    gradeEl.textContent = profile.grade;
    titleEl.textContent = `第 ${profile.councilNumber} 次正式議事會`;
    summaryEl.textContent = profile.score < 0
      ? '目前的共同缺陷與方法重疊超過互補優勢，請替換成員或先累積共同經歷。'
      : profile.score === 0
        ? '這支隊伍能穩定合作，但尚未形成強烈的互補優勢。'
        : '這支隊伍的不同人生道路已形成可持續的共同方法。';
    costEl.textContent = `${profile.councilCost} G`;
    rewardEl.textContent = `每人 +${profile.bondReward}`;

    factorsEl.replaceChildren();
    if (profile.factors.length === 0) {
      factorsEl.append(text('p', '目前沒有形成明顯的正負因素。', 'empty-copy'));
    } else {
      for (const entry of profile.factors) {
        const row = document.createElement('div');
        row.className = `factor ${entry.value >= 0 ? 'positive' : 'negative'}`;
        const amount = text('b', entry.value > 0 ? `+${entry.value}` : String(entry.value));
        const copy = document.createElement('div');
        copy.append(text('strong', entry.label), text('span', entry.detail));
        row.append(amount, copy);
        factorsEl.append(row);
      }
    }

    blockersEl.replaceChildren();
    blockersEl.hidden = profile.blockingReasons.length === 0;
    for (const reason of profile.blockingReasons) blockersEl.append(text('p', reason));
    conductButton.disabled = !profile.eligible;
    conductButton.textContent = profile.eligible
      ? `支付 ${profile.councilCost} G，召開議事會`
      : '目前無法召開';
  }

  conductButton.addEventListener('click', () => {
    const latest = loadGame();
    if (!latest) {
      messageEl.textContent = '存檔已不存在，請重新整理。';
      return;
    }
    try {
      const result = conductTeamCouncil(latest, [...selected]);
      saveGame(latest);
      save = latest;
      messageEl.textContent = `第 ${result.councilNumber} 次議事會完成；${result.affectedCompanionIds.length} 名旅伴羈絆各 +${result.bondReward}。`;
      render();
    } catch (error) {
      messageEl.textContent = error instanceof Error ? error.message : '議事會失敗。';
      save = latest;
      render();
    }
  });

  window.addEventListener('storage', (event) => {
    if (event.key !== SAVE_KEY) return;
    save = loadGame();
    if (!save) {
      appEl.hidden = true;
      emptyEl.hidden = false;
      return;
    }
    initializeSelection();
    render();
  });

  if (!save) {
    emptyEl.hidden = false;
  } else {
    appEl.hidden = false;
    initializeSelection();
    render();
  }
</script>

<style>
  :global(body) { background: #12100d; color: #eee5d2; }
  .chemistry-shell { width: min(1080px, calc(100% - 28px)); margin: 0 auto; padding: 42px 0 80px; }
  .hero { padding: 32px; border: 1px solid #574936; background: linear-gradient(135deg, #211a13, #15120e); }
  .eyebrow { margin: 0 0 8px; color: #c8a66a; font-size: .72rem; letter-spacing: .18em; text-transform: uppercase; }
  h1, h2, p { margin-top: 0; }
  h1 { margin-bottom: 12px; font-size: clamp(2rem, 5vw, 4rem); }
  .hero > p:not(.eyebrow) { max-width: 760px; color: #c7bdac; line-height: 1.75; }
  nav { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 20px; }
  a { color: #e4c98d; }
  .panel { margin-top: 18px; padding: 24px; border: 1px solid #443a2d; background: #1a1713; }
  .section-head, .result-panel { display: flex; justify-content: space-between; gap: 20px; align-items: center; }
  .counter, .hint, .member-card span, .member-card small, .factor span, .message { color: #aaa092; }
  .member-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-top: 18px; }
  .member-card { display: flex; gap: 12px; align-items: flex-start; padding: 16px; border: 1px solid #4b4032; background: #211d17; cursor: pointer; }
  .member-card:has(input:checked) { border-color: #d0aa61; background: #2b2419; }
  .member-card.injured { opacity: .55; cursor: not-allowed; }
  .member-card input { margin-top: 4px; accent-color: #c99e50; }
  .member-card div { display: grid; gap: 5px; }
  .member-card small { line-height: 1.45; }
  .score-orb { flex: 0 0 132px; aspect-ratio: 1; display: grid; place-content: center; text-align: center; border: 1px solid #b98d46; border-radius: 50%; background: #241c12; }
  .score-orb strong { font-size: 2.8rem; }
  .score-orb span { color: #d8bb7f; }
  .result-copy { flex: 1; }
  .metrics { display: flex; gap: 18px; flex-wrap: wrap; }
  .metrics span { padding: 8px 12px; background: #262119; border: 1px solid #463b2c; }
  .factor-list { display: grid; gap: 10px; }
  .factor { display: grid; grid-template-columns: 44px 1fr; gap: 12px; align-items: center; padding: 13px; border: 1px solid #41372b; }
  .factor b { font-size: 1.25rem; text-align: center; }
  .factor div { display: grid; gap: 3px; }
  .factor.positive b { color: #a9cf86; }
  .factor.negative b { color: #e4917d; }
  .blockers { margin-top: 16px; padding: 12px 16px; border-left: 3px solid #b75747; background: #2b1916; }
  .blockers p { margin: 4px 0; }
  button, .primary-link { display: inline-block; margin-top: 18px; padding: 12px 18px; border: 1px solid #d0aa61; background: #b88738; color: #160f08; font: inherit; font-weight: 700; cursor: pointer; text-decoration: none; }
  button:disabled { opacity: .45; cursor: not-allowed; }
  .message { margin: 12px 0 0; min-height: 1.5em; }
  @media (max-width: 650px) {
    .hero, .panel { padding: 18px; }
    .result-panel { align-items: flex-start; }
    .score-orb { flex-basis: 96px; }
    .score-orb strong { font-size: 2rem; }
  }
</style>
