---
/**
 * /games/delve — DELVE 深掘：2D 沙盒挖掘建造（單機、Canvas2D、程式產生像素材質）。
 * 引擎在 src/scripts/games/delve/engine（純邏輯），本頁只放標題 / HUD 骨架與樣式。
 */
import BaseLayout from '@components/layout/BaseLayout.astro';
import { defaultLang, type Language } from '@i18n/index';
import DelveLevels from '@components/delve/DelveLevels.astro';

const lang: Language = defaultLang;
---

<BaseLayout title="Dungeon Arcade — DELVE 深掘" description="網頁 2D 沙盒：挖礦、合成、建造，在瀏覽器裡往地底深掘" lang={lang}>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Press+Start+2P&display=swap" />

  <main class="delve" id="delve-root" data-phase="title" data-title="press">
    <canvas id="delve-canvas" class="delve-canvas" aria-label="DELVE 遊戲畫面"></canvas>

    <div class="delve-hud" id="delve-hud" hidden>
      <div class="delve-hotbar" id="delve-hotbar" role="toolbar" aria-label="快捷欄"></div>
      <div class="delve-held" id="delve-held" aria-live="polite"></div>
      <div class="delve-status" id="delve-status"></div>
      <button class="delve-clock" id="delve-clock" type="button" data-testid="hud-clock"><span class="delve-clock-text" id="delve-clock-text"></span></button>
      <div class="delve-vitals" id="delve-vitals" aria-label="生命">
        <canvas class="delve-hearts" id="delve-hearts" width="51" height="10"></canvas>
        <span class="delve-hp-text" id="delve-hp-text"></span>
        <canvas class="delve-mana" id="delve-mana" width="41" height="5" hidden aria-label="魔力"></canvas>
        <span class="delve-undying" id="delve-undying" hidden data-testid="undying"></span>
        <span class="delve-buffs" id="delve-buffs" hidden data-testid="buffs"></span>
      </div>
      <div class="delve-boss" id="delve-boss" hidden>
        <span class="delve-boss-name" id="delve-boss-name"></span>
        <canvas class="delve-boss-bar" id="delve-boss-bar" width="160" height="8"></canvas>
      </div>
      <div class="delve-death" id="delve-death" hidden role="status" aria-live="assertive">
        <p class="delve-death-title">你倒下了</p>
        <p class="delve-death-msg" id="delve-death-msg"></p>
      </div>
      <div class="delve-tip" id="delve-tip" hidden role="tooltip"></div>
      <div class="delve-corner">
        <button class="delve-chip delve-chip--zoom" id="delve-zoom-out" type="button" aria-label="縮小（看到更多格子）">－<kbd class="delve-kbd">-</kbd></button>
        <button class="delve-chip delve-chip--zoom" id="delve-zoom-in" type="button" aria-label="放大">＋<kbd class="delve-kbd">=</kbd></button>
        <button class="delve-chip" id="delve-inv-btn" type="button">背包<kbd class="delve-kbd">E</kbd></button>
        <button class="delve-chip" id="delve-map-btn" type="button">地圖<kbd class="delve-kbd">M</kbd></button>
        <button class="delve-chip" id="delve-journal-btn" type="button">日誌<kbd class="delve-kbd">J</kbd></button>
        <button class="delve-chip delve-chip--settle" id="delve-settle-btn" type="button">據點<kbd class="delve-kbd">B</kbd></button>
        <button class="delve-chip delve-chip--house" id="delve-house-btn" type="button" aria-pressed="false">查房<kbd class="delve-kbd">H</kbd></button>
        <button class="delve-chip delve-chip--quests" id="delve-quests-btn" type="button" aria-pressed="false">委託<kbd class="delve-kbd">L</kbd></button>
        <button class="delve-chip delve-chip--aim" id="delve-aim-btn" type="button" aria-pressed="false">自動瞄準</button>
        <button class="delve-chip" id="delve-menu-btn" type="button">選單<kbd class="delve-kbd">Esc</kbd></button>
      </div>

      <div class="delve-minimap" id="delve-minimap" data-zoom="2">
        <canvas class="delve-minimap-canvas" id="delve-minimap-canvas" width="120" height="80" aria-label="小地圖（點一下開全地圖）"></canvas>
        <div class="delve-minimap-btns">
          <button class="delve-mm-btn" id="delve-mm-out" type="button" aria-label="小地圖縮小">－</button>
          <span class="delve-mm-label">地圖<kbd class="delve-kbd">N</kbd></span>
          <button class="delve-mm-btn" id="delve-mm-in" type="button" aria-label="小地圖放大">＋</button>
        </div>
      </div>

      <div class="delve-banner" id="delve-banner" aria-live="polite">
        <span class="delve-banner-sub" id="delve-banner-sub"></span>
        <span class="delve-banner-title" id="delve-banner-title"></span>
      </div>

      <div class="delve-wlabels" id="delve-wlabels" aria-hidden="true"></div>

      <section class="delve-panel delve-panel--settle" id="delve-settle" hidden aria-label="據點">
        <header class="delve-panel-head">
          <h2 id="delve-settle-title">據點</h2>
          <button class="delve-x" id="delve-settle-close" type="button" aria-label="關閉據點面板">×</button>
        </header>
        <div class="delve-settle-body" id="delve-settle-body"></div>
      </section>

      <section class="delve-panel delve-panel--npc" id="delve-npc" hidden aria-label="居民">
        <header class="delve-panel-head">
          <h2 id="delve-npc-title">居民</h2>
          <button class="delve-x" id="delve-npc-close" type="button" aria-label="關閉居民面板">×</button>
        </header>
        <div class="delve-npc-body" id="delve-npc-body"></div>
      </section>

      <section class="delve-panel delve-panel--npc delve-panel--folk" id="delve-folk" hidden aria-label="NPC" data-testid="folk-panel">
        <header class="delve-panel-head">
          <h2 id="delve-folk-title">NPC</h2>
          <button class="delve-x" id="delve-folk-close" type="button" aria-label="關閉 NPC 面板">×</button>
        </header>
        <div class="delve-npc-body" id="delve-folk-body"></div>
      </section>

      <section class="delve-panel delve-panel--quests" id="delve-quests" hidden aria-label="委託清單">
        <header class="delve-panel-head">
          <h2>委託清單</h2>
          <button class="delve-x" id="delve-quests-close" type="button" aria-label="關閉委託清單">×</button>
        </header>
        <div class="delve-quests-body" id="delve-quests-body"></div>
      </section>

      <section class="delve-panel delve-panel--journal" id="delve-journal" hidden aria-label="探險日誌">
        <header class="delve-panel-head">
          <h2>探險日誌</h2>
          <button class="delve-x" id="delve-journal-close" type="button" aria-label="關閉日誌">×</button>
        </header>
        <div class="delve-journal-body" id="delve-journal-body"></div>
      </section>

      <section class="delve-panel delve-panel--calendar" id="delve-calendar" hidden aria-label="日曆與天氣">
        <header class="delve-panel-head">
          <h2>日曆與天氣</h2>
          <button class="delve-x" id="delve-calendar-close" type="button" aria-label="關閉日曆">×</button>
        </header>
        <div class="delve-cal-body" id="delve-calendar-body"></div>
      </section>

      <section class="delve-lore" id="delve-lore" hidden role="dialog" aria-labelledby="delve-lore-title">
        <div class="delve-lore-box">
          <p class="delve-lore-kicker" id="delve-lore-kicker"></p>
          <h2 class="delve-lore-title" id="delve-lore-title"></h2>
          <p class="delve-lore-text" id="delve-lore-text"></p>
          <button class="delve-btn delve-lore-close" id="delve-lore-close" type="button">收起</button>
        </div>
      </section>

      <section class="delve-panel" id="delve-inv" hidden aria-label="背包與合成">
        <header class="delve-panel-head">
          <h2>背包</h2>
          <button class="delve-x" id="delve-inv-close" type="button" aria-label="關閉">×</button>
        </header>
        <p class="delve-hint">點一格再點另一格可以搬移 / 交換；滑鼠停在道具上（觸控：長按）看說明</p>
        <div class="delve-inv-grid" id="delve-inv-grid"></div>
        <div class="delve-gear-actions" id="delve-gear-actions">
          <button class="delve-btn delve-btn--sm" id="delve-lock-btn" type="button" hidden>鎖定</button>
          <button class="delve-btn delve-btn--sm" id="delve-salvage-btn" type="button" hidden>分解</button>
          <button class="delve-btn delve-btn--sm" id="delve-forge-btn" type="button" hidden>鍛造</button>
          <button class="delve-btn delve-btn--sm delve-btn--danger" id="delve-salvage-all" type="button">分解所有普通</button>
          <span class="delve-mats" id="delve-mats" data-testid="mats"></span>
        </div>
        <h2 class="delve-craft-title">裝備</h2>
        <p class="delve-hint">選背包裡的防具 / 飾品 / 時裝再點格子（或按「裝上」、右鍵背包格）；點格子卸下。外觀欄只改樣子，數值看防具。</p>
        <div class="delve-doll-row">
          <figure class="delve-doll" id="delve-doll" data-testid="doll-preview">
            <canvas class="delve-doll-canvas" id="delve-doll-canvas" width="52" height="54" aria-label="角色紙娃娃預覽"></canvas>
            <figcaption class="delve-doll-cap">目前的樣子</figcaption>
          </figure>
          <div class="delve-equip-cols">
            <div class="delve-equip-col">
              <h3 class="delve-equip-h">防具 · 飾品</h3>
              <div class="delve-equip" id="delve-equip"></div>
            </div>
            <div class="delve-equip-col">
              <h3 class="delve-equip-h">外觀（時裝）</h3>
              <div class="delve-vanity" id="delve-vanity"></div>
            </div>
            <div class="delve-hide-wrap">
              <span class="delve-equip-h" id="delve-hide-h">隱藏防具的樣子</span>
              <div class="delve-hide-row" id="delve-hide-row" role="group" aria-labelledby="delve-hide-h"></div>
            </div>
          </div>
          <button class="delve-btn delve-equip-btn" id="delve-equip-btn" type="button" hidden>裝上</button>
        </div>
        <h2 class="delve-craft-title">能力總覽</h2>
        <div class="delve-stats" id="delve-stats" data-testid="stats-panel"></div>
        <h2 class="delve-craft-title">合成</h2>
        <p class="delve-hint" id="delve-station"></p>
        <ul class="delve-recipes" id="delve-recipes"></ul>
      </section>

      <section class="delve-panel delve-panel--chest" id="delve-chest" hidden aria-label="箱子">
        <header class="delve-panel-head">
          <h2>箱子</h2>
          <button class="delve-x" id="delve-chest-close" type="button" aria-label="關閉箱子">×</button>
        </header>
        <p class="delve-hint">點箱子裡的格子拿走；點背包的格子把整堆放進箱子</p>
        <div class="delve-inv-grid" id="delve-chest-grid"></div>
        <button class="delve-btn delve-chest-takeall" id="delve-chest-takeall" type="button">全部拿取</button>
      </section>

      <section class="delve-panel delve-panel--forge" id="delve-forge" hidden aria-label="鍛造台">
        <header class="delve-panel-head">
          <h2>鍛造台</h2>
          <button class="delve-x" id="delve-forge-close" type="button" aria-label="關閉鍛造台">×</button>
        </header>
        <p class="delve-hint" id="delve-forge-station"></p>
        <div class="delve-forge-item" id="delve-forge-item"></div>
        <h3 class="delve-forge-h">強化 / 升階</h3>
        <div class="delve-forge-ops" id="delve-forge-ops"></div>
        <h3 class="delve-forge-h">洗煉：換掉一條詞條</h3>
        <ul class="delve-forge-affixes" id="delve-forge-affixes"></ul>
        <p class="delve-hint" id="delve-forge-mats"></p>
      </section>

      <section class="delve-confirm" id="delve-salvage-confirm" hidden role="alertdialog" aria-modal="true" aria-labelledby="delve-sc-title" aria-describedby="delve-sc-msg">
        <div class="delve-menu-box">
          <h2 id="delve-sc-title">分解裝備？</h2>
          <p class="delve-confirm-msg" id="delve-sc-msg"></p>
          <div class="delve-confirm-btns">
            <button class="delve-btn" id="delve-sc-cancel" type="button">取消</button>
            <button class="delve-btn delve-btn--danger" id="delve-sc-ok" type="button">分解</button>
          </div>
        </div>
      </section>

      <div class="delve-touch" aria-hidden="true">
        <div class="delve-joy" id="delve-joy"><span class="delve-joy-knob"></span></div>
        <button class="delve-jump" id="delve-jump" type="button" tabindex="-1">跳</button>
      </div>
      <div class="delve-toast" id="delve-toast" role="status" aria-live="polite"></div>
      <DelveLevels />
    </div>

    <section class="delve-map" id="delve-map" hidden aria-label="全地圖">
      <canvas class="delve-map-canvas" id="delve-map-canvas" aria-label="地圖：拖曳移動、滾輪縮放、點一下放標記"></canvas>
      <header class="delve-map-head">
        <h2>地圖</h2>
        <p class="delve-map-info" id="delve-map-info"></p>
        <div class="delve-map-btns">
          <button class="delve-chip" id="delve-map-out" type="button" aria-label="地圖縮小">－</button>
          <button class="delve-chip" id="delve-map-in" type="button" aria-label="地圖放大">＋</button>
          <button class="delve-chip" id="delve-map-center" type="button">回到玩家</button>
          <button class="delve-chip" id="delve-map-close" type="button">關閉<kbd class="delve-kbd">M</kbd></button>
        </div>
      </header>
      <p class="delve-map-help">拖曳移動 · 滾輪 / 雙指縮放 · 點一下放置或移除標記（最多 20 個）</p>
    </section>

    <section class="delve-menu" id="delve-menu" hidden aria-label="選單">
      <div class="delve-menu-box">
        <h2>暫停</h2>
        <button class="delve-btn" id="delve-resume" type="button">繼續遊戲</button>
        <button class="delve-btn" id="delve-look-menu" type="button">角色外觀</button>
        <button class="delve-btn" id="delve-peaceful" type="button" aria-pressed="false">難度：一般</button>
        <button class="delve-btn" id="delve-help-btn" type="button">操作說明</button>
        <button class="delve-btn" id="delve-calendar-btn" type="button">日曆與天氣</button>
        <button class="delve-btn" id="delve-settle-menu" type="button">據點與查房</button>
        <button class="delve-btn" id="delve-quests-menu" type="button">委託清單</button>
        <button class="delve-btn" id="delve-save" type="button">立即存檔</button>
        <button class="delve-btn" id="delve-export" type="button">匯出存檔 .delve</button>
        <button class="delve-btn" id="delve-import-menu" type="button">匯入存檔</button>
        <button class="delve-btn" id="delve-to-title" type="button">回到標題</button>
        <a class="delve-btn delve-btn--ghost" href="/games">回遊戲廳</a>
        <p class="delve-msg" id="delve-menu-msg" role="status"></p>
        <p class="delve-note">每 30 秒與離開頁面時自動存在這個瀏覽器。瀏覽器（尤其 iOS Safari）可能清除網站資料，重要的世界請匯出備份。</p>
      </div>
    </section>

    <section class="delve-help" id="delve-help" hidden role="dialog" aria-modal="true" aria-labelledby="delve-help-title">
      <div class="delve-menu-box delve-help-box">
        <h2 id="delve-help-title">操作說明</h2>
        <ul class="delve-help-list delve-help-list--keys">
          <li><kbd class="delve-help-key">A</kbd><kbd class="delve-help-key">D</kbd><span>左右移動</span></li>
          <li><kbd class="delve-help-key">Space</kbd><span>跳躍（W / S 爬繩、S 穿過平台）</span></li>
          <li><kbd class="delve-help-key">左鍵</kbd><span>挖掘；拿武器時攻擊</span></li>
          <li><kbd class="delve-help-key">右鍵</kbd><span>放置方塊 / 開箱 / 使用道具</span></li>
          <li><kbd class="delve-help-key">1–0</kbd><span>換快捷欄（或滾輪）；開局第 3 格是木劍</span></li>
          <li><kbd class="delve-help-key">E</kbd><span>背包與合成</span></li>
          <li><kbd class="delve-help-key">M</kbd><span>地圖（N 小地圖、J 日誌）</span></li>
          <li><kbd class="delve-help-key">B</kbd><span>據點面板（H 查房模式：看哪間房可以住人）</span></li>
          <li><kbd class="delve-help-key">K</kbd><span>角色 / 技能樹（升級拿技能點；Q 突進、F 震地、R 尋礦感知）</span></li>
        </ul>
        <ul class="delve-help-list delve-help-list--touch">
          <li><span class="delve-help-key">搖桿</span><span>左下拖曳移動</span></li>
          <li><span class="delve-help-key">跳</span><span>右下按鈕跳躍</span></li>
          <li><span class="delve-help-key">點格子</span><span>挖掘或放置；拿武器時點畫面攻擊</span></li>
          <li><span class="delve-help-key">快捷欄</span><span>點一下換格；開局第 3 格是木劍</span></li>
          <li><span class="delve-help-key">背包</span><span>右上「背包」看道具與合成</span></li>
          <li><span class="delve-help-key">地圖</span><span>右上「地圖」或點小地圖</span></li>
          <li><span class="delve-help-key">技能</span><span>右上「技能」分配技能點；學會的主動技能在跳躍鍵旁</span></li>
        </ul>
        <p class="delve-note">晚上怪物比較多：先蓋個小屋、放張床當重生點。放下「據點爐心」、把房子補齊門 / 燈 / 桌椅 / 床，就會有居民搬來。之後可從選單的「操作說明」再打開。</p>
        <button class="delve-btn delve-btn--main" id="delve-help-close" type="button">知道了</button>
      </div>
    </section>

    <section class="delve-confirm" id="delve-confirm" hidden role="alertdialog" aria-modal="true" aria-labelledby="delve-confirm-title" aria-describedby="delve-confirm-msg">
      <div class="delve-menu-box">
        <h2 id="delve-confirm-title">確定嗎？</h2>
        <p class="delve-confirm-msg" id="delve-confirm-msg"></p>
        <div class="delve-confirm-btns">
          <button class="delve-btn" id="delve-confirm-cancel" type="button">取消</button>
          <button class="delve-btn delve-btn--danger" id="delve-confirm-ok" type="button">確定</button>
        </div>
      </div>
    </section>

    <div class="delve-loading" id="delve-loading" hidden role="status" aria-live="polite">
      <div class="delve-loading-box">
        <canvas class="delve-loading-logo" id="delve-loading-logo" width="1" height="1" aria-hidden="true"></canvas>
        <p class="delve-loading-en" aria-hidden="true">GENERATING WORLD</p>
        <p class="delve-loading-text" id="delve-loading-text">生成世界中…</p>
        <div class="delve-gen-frame">
          <canvas class="delve-gen-map" id="delve-gen-map" width="280" height="80" aria-hidden="true"></canvas>
        </div>
        <ol class="delve-gen-phases" id="delve-gen-phases" aria-label="生成階段">
          {['地形', '洞穴', '礦脈', '地城', '草木', '液體'].map((p) => <li class="delve-gen-phase">{p}</li>)}
        </ol>
        <div class="delve-progress" id="delve-progress" role="progressbar" aria-label="世界生成進度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          {Array.from({ length: 20 }, () => <span class="delve-progress-cell"></span>)}
        </div>
        <p class="delve-loading-stage" id="delve-loading-stage"></p>
        <p class="delve-loading-tip" id="delve-loading-tip"></p>
      </div>
    </div>

    <section class="delve-title" id="delve-title" aria-labelledby="delve-title-h">
      <div class="delve-tt">
        <header class="delve-tt-head">
          <h1 class="delve-tt-h" id="delve-title-h">
            <canvas class="delve-logo" id="delve-logo" width="1" height="1" aria-hidden="true"></canvas>
            <span class="delve-sr">DELVE 深掘</span>
          </h1>
          <p class="delve-tt-kanji" aria-hidden="true">深掘</p>
          <p class="delve-tagline">DIG · CRAFT · BUILD</p>
        </header>

        <button class="delve-press" id="delve-press" type="button">
          <span class="delve-press-keys">按任意鍵開始</span><span class="delve-press-touch">點一下開始</span>
          <span class="delve-press-en" aria-hidden="true">PRESS ANY KEY</span>
        </button>
