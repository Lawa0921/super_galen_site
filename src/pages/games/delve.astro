---
/**
 * /games/delve — DELVE 深掘：2D 沙盒挖掘建造（單機、Canvas2D、程式產生像素材質）。
 * 引擎在 src/scripts/games/delve/engine（純邏輯），本頁只放標題 / HUD 骨架與樣式。
 */
import BaseLayout from '@components/layout/BaseLayout.astro';
import { defaultLang, type Language } from '@i18n/index';

const lang: Language = defaultLang;
---

<BaseLayout title="Dungeon Arcade — DELVE 深掘" description="網頁 2D 沙盒：挖礦、合成、建造，在瀏覽器裡往地底深掘" lang={lang}>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Press+Start+2P&display=swap" />

  <main class="delve" id="delve-root" data-phase="title">
    <canvas id="delve-canvas" class="delve-canvas" aria-label="DELVE 遊戲畫面"></canvas>

    <div class="delve-hud" id="delve-hud" hidden>
      <div class="delve-hotbar" id="delve-hotbar" role="toolbar" aria-label="快捷欄"></div>
      <div class="delve-held" id="delve-held" aria-live="polite"></div>
      <div class="delve-status" id="delve-status"></div>
      <div class="delve-vitals" id="delve-vitals" aria-label="生命">
        <canvas class="delve-hearts" id="delve-hearts" width="51" height="10"></canvas>
        <span class="delve-hp-text" id="delve-hp-text"></span>
        <canvas class="delve-mana" id="delve-mana" width="41" height="5" hidden aria-label="魔力"></canvas>
      </div>
      <div class="delve-boss" id="delve-boss" hidden>
        <span class="delve-boss-name" id="delve-boss-name"></span>
        <canvas class="delve-boss-bar" id="delve-boss-bar" width="160" height="8"></canvas>
      </div>
      <div class="delve-death" id="delve-death" hidden role="status" aria-live="assertive">
        <p class="delve-death-title">你倒下了</p>
        <p class="delve-death-msg" id="delve-death-msg"></p>
      </div>
      <div class="delve-tip" id="delve-tip" hidden role="tooltip"></div>
      <div class="delve-corner">
        <button class="delve-chip delve-chip--zoom" id="delve-zoom-out" type="button" aria-label="縮小（看到更多格子）">－<kbd class="delve-kbd">-</kbd></button>
        <button class="delve-chip delve-chip--zoom" id="delve-zoom-in" type="button" aria-label="放大">＋<kbd class="delve-kbd">=</kbd></button>
        <button class="delve-chip" id="delve-inv-btn" type="button">背包<kbd class="delve-kbd">E</kbd></button>
        <button class="delve-chip" id="delve-map-btn" type="button">地圖<kbd class="delve-kbd">M</kbd></button>
        <button class="delve-chip" id="delve-journal-btn" type="button">日誌<kbd class="delve-kbd">J</kbd></button>
        <button class="delve-chip delve-chip--aim" id="delve-aim-btn" type="button" aria-pressed="false">自動瞄準</button>
        <button class="delve-chip" id="delve-menu-btn" type="button">選單<kbd class="delve-kbd">Esc</kbd></button>
      </div>

      <div class="delve-minimap" id="delve-minimap" data-zoom="2">
        <canvas class="delve-minimap-canvas" id="delve-minimap-canvas" width="120" height="80" aria-label="小地圖（點一下開全地圖）"></canvas>
        <div class="delve-minimap-btns">
          <button class="delve-mm-btn" id="delve-mm-out" type="button" aria-label="小地圖縮小">－</button>
          <span class="delve-mm-label">地圖<kbd class="delve-kbd">N</kbd></span>
          <button class="delve-mm-btn" id="delve-mm-in" type="button" aria-label="小地圖放大">＋</button>
        </div>
      </div>

      <div class="delve-banner" id="delve-banner" aria-live="polite">
        <span class="delve-banner-sub" id="delve-banner-sub"></span>
        <span class="delve-banner-title" id="delve-banner-title"></span>
      </div>

      <section class="delve-panel delve-panel--journal" id="delve-journal" hidden aria-label="探險日誌">
        <header class="delve-panel-head">
          <h2>探險日誌</h2>
          <button class="delve-x" id="delve-journal-close" type="button" aria-label="關閉日誌">×</button>
        </header>
        <div class="delve-journal-body" id="delve-journal-body"></div>
      </section>

      <section class="delve-lore" id="delve-lore" hidden role="dialog" aria-labelledby="delve-lore-title">
        <div class="delve-lore-box">
          <p class="delve-lore-kicker" id="delve-lore-kicker"></p>
          <h2 class="delve-lore-title" id="delve-lore-title"></h2>
          <p class="delve-lore-text" id="delve-lore-text"></p>
          <button class="delve-btn delve-lore-close" id="delve-lore-close" type="button">收起</button>
        </div>
      </section>

      <section class="delve-panel" id="delve-inv" hidden aria-label="背包與合成">
        <header class="delve-panel-head">
          <h2>背包</h2>
          <button class="delve-x" id="delve-inv-close" type="button" aria-label="關閉">×</button>
        </header>
        <p class="delve-hint">點一格再點另一格可以搬移 / 交換；滑鼠停在道具上（觸控：長按）看說明</p>
        <div class="delve-inv-grid" id="delve-inv-grid"></div>
        <h2 class="delve-craft-title">裝備</h2>
        <p class="delve-hint">選背包裡的防具 / 飾品再點裝備格（或按「裝上」、右鍵背包格）；點裝備格卸下</p>
        <div class="delve-equip-row">
          <div class="delve-equip" id="delve-equip"></div>
          <button class="delve-btn delve-equip-btn" id="delve-equip-btn" type="button" hidden>裝上</button>
        </div>
        <p class="delve-hint delve-stats" id="delve-stats"></p>
        <h2 class="delve-craft-title">合成</h2>
        <p class="delve-hint" id="delve-station"></p>
        <ul class="delve-recipes" id="delve-recipes"></ul>
      </section>

      <section class="delve-panel delve-panel--chest" id="delve-chest" hidden aria-label="箱子">
        <header class="delve-panel-head">
          <h2>箱子</h2>
          <button class="delve-x" id="delve-chest-close" type="button" aria-label="關閉箱子">×</button>
        </header>
        <p class="delve-hint">點箱子裡的格子拿走；點背包的格子把整堆放進箱子</p>
        <div class="delve-inv-grid" id="delve-chest-grid"></div>
        <button class="delve-btn delve-chest-takeall" id="delve-chest-takeall" type="button">全部拿取</button>
      </section>

      <div class="delve-touch" aria-hidden="true">
        <div class="delve-joy" id="delve-joy"><span class="delve-joy-knob"></span></div>
        <button class="delve-jump" id="delve-jump" type="button" tabindex="-1">跳</button>
      </div>
      <div class="delve-toast" id="delve-toast" role="status" aria-live="polite"></div>
    </div>

    <section class="delve-map" id="delve-map" hidden aria-label="全地圖">
      <canvas class="delve-map-canvas" id="delve-map-canvas" aria-label="地圖：拖曳移動、滾輪縮放、點一下放標記"></canvas>
      <header class="delve-map-head">
        <h2>地圖</h2>
        <p class="delve-map-info" id="delve-map-info"></p>
        <div class="delve-map-btns">
          <button class="delve-chip" id="delve-map-out" type="button" aria-label="地圖縮小">－</button>
          <button class="delve-chip" id="delve-map-in" type="button" aria-label="地圖放大">＋</button>
          <button class="delve-chip" id="delve-map-center" type="button">回到玩家</button>
          <button class="delve-chip" id="delve-map-close" type="button">關閉<kbd class="delve-kbd">M</kbd></button>
        </div>
      </header>
      <p class="delve-map-help">拖曳移動 · 滾輪 / 雙指縮放 · 點一下放置或移除標記（最多 20 個）</p>
    </section>

    <section class="delve-menu" id="delve-menu" hidden aria-label="選單">
      <div class="delve-menu-box">
        <h2>暫停</h2>
        <button class="delve-btn" id="delve-resume" type="button">繼續遊戲</button>
        <button class="delve-btn" id="delve-peaceful" type="button" aria-pressed="false">難度：一般</button>
        <button class="delve-btn" id="delve-help-btn" type="button">操作說明</button>
        <button class="delve-btn" id="delve-save" type="button">立即存檔</button>
        <button class="delve-btn" id="delve-export" type="button">匯出存檔 .delve</button>
        <button class="delve-btn" id="delve-import-menu" type="button">匯入存檔</button>
        <a class="delve-btn delve-btn--ghost" href="/games">回遊戲廳</a>
        <p class="delve-msg" id="delve-menu-msg" role="status"></p>
        <p class="delve-note">每 30 秒與離開頁面時自動存在這個瀏覽器。瀏覽器（尤其 iOS Safari）可能清除網站資料，重要的世界請匯出備份。</p>
      </div>
    </section>

    <section class="delve-help" id="delve-help" hidden role="dialog" aria-modal="true" aria-labelledby="delve-help-title">
      <div class="delve-menu-box delve-help-box">
        <h2 id="delve-help-title">操作說明</h2>
        <ul class="delve-help-list delve-help-list--keys">
          <li><kbd class="delve-help-key">A</kbd><kbd class="delve-help-key">D</kbd><span>左右移動</span></li>
          <li><kbd class="delve-help-key">Space</kbd><span>跳躍（W / S 爬繩、S 穿過平台）</span></li>
          <li><kbd class="delve-help-key">左鍵</kbd><span>挖掘；拿武器時攻擊</span></li>
          <li><kbd class="delve-help-key">右鍵</kbd><span>放置方塊 / 開箱 / 使用道具</span></li>
          <li><kbd class="delve-help-key">1–0</kbd><span>換快捷欄（或滾輪）；開局第 3 格是木劍</span></li>
          <li><kbd class="delve-help-key">E</kbd><span>背包與合成</span></li>
          <li><kbd class="delve-help-key">M</kbd><span>地圖（N 小地圖、J 日誌）</span></li>
        </ul>
        <ul class="delve-help-list delve-help-list--touch">
          <li><span class="delve-help-key">搖桿</span><span>左下拖曳移動</span></li>
          <li><span class="delve-help-key">跳</span><span>右下按鈕跳躍</span></li>
          <li><span class="delve-help-key">點格子</span><span>挖掘或放置；拿武器時點畫面攻擊</span></li>
          <li><span class="delve-help-key">快捷欄</span><span>點一下換格；開局第 3 格是木劍</span></li>
          <li><span class="delve-help-key">背包</span><span>右上「背包」看道具與合成</span></li>
          <li><span class="delve-help-key">地圖</span><span>右上「地圖」或點小地圖</span></li>
        </ul>
        <p class="delve-note">晚上怪物比較多：先蓋個小屋、放張床當重生點。之後可從選單的「操作說明」再打開。</p>
        <button class="delve-btn delve-btn--main" id="delve-help-close" type="button">知道了</button>
      </div>
    </section>

    <section class="delve-confirm" id="delve-confirm" hidden role="alertdialog" aria-modal="true" aria-labelledby="delve-confirm-title" aria-describedby="delve-confirm-msg">
      <div class="delve-menu-box">
        <h2 id="delve-confirm-title">覆蓋存檔？</h2>
        <p class="delve-confirm-msg" id="delve-confirm-msg"></p>
        <div class="delve-confirm-btns">
          <button class="delve-btn" id="delve-confirm-cancel" type="button">取消</button>
          <button class="delve-btn delve-btn--danger" id="delve-confirm-ok" type="button">覆蓋</button>
        </div>
      </div>
    </section>

    <div class="delve-loading" id="delve-loading" hidden role="status" aria-live="polite">
      <div class="delve-menu-box"><p class="delve-loading-text">生成世界中…</p></div>
    </div>

    <section class="delve-title" id="delve-title">
      <a class="delve-home" href="/games">← ARCADE</a>
      <div class="delve-title-fg">
        <h1 class="delve-logo">DELVE<small>深掘</small></h1>
        <p class="delve-tagline">DIG · CRAFT · BUILD</p>
        <p class="delve-story">一把木鎬、一把木劍、十支火把。往下挖，找到銅與鐵，打造更好的鎬，看看地底有多深。</p>
        <label class="delve-seed">種子
          <input id="delve-seed" type="text" maxlength="32" placeholder="留空＝隨機" autocomplete="off" spellcheck="false" />
        </label>
        <div class="delve-title-btns">
          <button class="delve-btn delve-btn--main" id="delve-new" type="button">新世界</button>
          <button class="delve-btn" id="delve-continue" type="button" hidden>繼續</button>
          <button class="delve-btn" id="delve-import" type="button">匯入</button>
        </div>
        <input id="delve-import-file" type="file" accept=".delve,application/x-delve-save,application/gzip" hidden />
        <p class="delve-msg" id="delve-title-msg" role="status"></p>
        <button class="delve-btn delve-btn--main" id="delve-upgrade-new" type="button" hidden>開始新世界</button>
        <p class="delve-keys">移動 A/D · 跳 Space · 爬繩 W/S · 挖 / 攻擊 左鍵 · 放置 / 開箱 / 使用 右鍵 · 換格 1–0/滾輪 · 背包 E · 地圖 M · 小地圖 N · 日誌 J · 縮放 - / =</p>
        <p class="delve-keys delve-keys--touch">左下搖桿移動 · 「跳」按鈕跳躍 · 點格子挖掘或放置 · 拿武器時點 / 按住畫面朝該處攻擊（可開自動瞄準）· 點快捷欄換格</p>
        <p class="delve-note">存檔留在這個瀏覽器（只有一個存檔位）；已有存檔時開新世界會先詢問是否覆蓋。iOS 等瀏覽器可能清除網站資料，請用選單匯出備份。</p>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { bootDelve } from '@scripts/games/delve/render/session';

  const root = document.getElementById('delve-root');
  if (root) {
    try {
      bootDelve(root);
    } catch (err) {
      console.error('[delve] boot failed', err);
    }
  }
</script>

<style is:global>
  .delve {
    /* 全部取自遊戲的統一色票（render/pixel.ts） */
    --ink: #f2e2b0;
    --dim: #b07a4b;
    --gold: #ffd86a;
    --outline: #0c0a12;
    /* 像素單位：main.ts 依畫面美術像素大小設 data-px（1–3） */
    --px: 2px;
    /* 斜面外框（左上亮、右下暗）＋ 1 單位黑描邊 */
    --bv-hi: #966139;
    --bv-lo: #2a1810;
    --bv-bg: #472819;
    /* 中文：DotGothic16 點陣字（16px 原生格），缺字時退回系統字 */
    --cjk: 'DotGothic16', 'Noto Sans TC', 'PingFang TC', 'Microsoft JhengHei', sans-serif;
    --pixel: 'Press Start 2P', 'DotGothic16', monospace;
    /* 1px 實心描邊（不模糊） */
    --text-outline: 1px 0 0 var(--outline), -1px 0 0 var(--outline), 0 1px 0 var(--outline), 0 -1px 0 var(--outline),
      1px 1px 0 var(--outline), -1px -1px 0 var(--outline), 1px -1px 0 var(--outline), -1px 1px 0 var(--outline);
    position: fixed;
    inset: 0;
    z-index: 50;
    overflow: hidden;
    background: #120c08;
    color: var(--ink);
    font-family: var(--cjk);
    font-size: 16px;
    -webkit-font-smoothing: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  .delve-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: none;
    image-rendering: pixelated;
    cursor: crosshair;
  }
  .delve[data-px='1'] { --px: 1px; }
  .delve[data-px='3'] { --px: 3px; }
  .delve [hidden] { display: none; }

  /* ── 像素外框：同一套斜面（實心 border + 無模糊外描邊） ── */
  .delve-slot,
  .delve-chip,
  .delve-panel,
  .delve-x,
  .delve-recipe,
  .delve-toast,
  .delve-menu-box,
  .delve-btn,
  .delve-seed input {
    border: var(--px) solid;
    border-color: var(--bv-hi) var(--bv-lo) var(--bv-lo) var(--bv-hi);
    border-radius: 0;
    background: var(--bv-bg);
    box-shadow: 0 0 0 var(--px) var(--outline);
  }
  .delve button { font: inherit; color: inherit; }

  /* ── HUD ── */
  .delve-hud { position: absolute; inset: 0; pointer-events: none; }
  .delve-hud > * { pointer-events: auto; }
  .delve-hud > .delve-toast,
  .delve-hud > .delve-held,
  .delve-hud > .delve-status { pointer-events: none; }

  .delve-hotbar {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    gap: calc(var(--px) * 3);
  }
  .delve-slot {
    --bv-hi: #623924;
    --bv-bg: #2a1810;
    --bv-lo: #1c1424;
    position: relative;
    width: calc(var(--px) * 22);
    height: calc(var(--px) * 22);
    padding: 0;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .delve-slot.is-selected { --bv-hi: #fff4c0; --bv-lo: #e8701c; --bv-bg: #623924; }
  .delve-slot.is-picked { --bv-hi: #cceaf8; --bv-lo: #2c4486; --bv-bg: #18204a; }
  .delve-slot-icon { width: calc(var(--px) * 16); height: calc(var(--px) * 16); image-rendering: pixelated; }
  .delve-slot-count {
    position: absolute;
    right: 1px;
    bottom: 1px;
    font-family: var(--pixel);
    font-size: 8px;
    line-height: 8px;
    color: #ffffff;
    text-shadow: var(--text-outline);
  }
  .delve-slot-key {
    position: absolute;
    left: 1px;
    top: 1px;
    font-family: var(--pixel);
    font-size: 8px;
    line-height: 8px;
    color: var(--dim);
    text-shadow: var(--text-outline);
  }
  .delve-held {
    position: absolute;
    top: calc(var(--px) * 22 + 18px);
    left: 12px;
    font-size: 16px;
    text-shadow: var(--text-outline);
  }
  .delve-status {
    position: absolute;
    top: calc(var(--px) * 22 + 40px);
    left: 12px;
    font-size: 16px;
    color: var(--ink);
    text-shadow: var(--text-outline);
  }
  .delve-corner { position: absolute; top: 10px; right: 10px; display: flex; gap: 8px; }
  .delve-chip {
    display: flex;
    gap: 6px;
    align-items: center;
    padding: 6px 10px;
    font-size: 16px;
    cursor: pointer;
  }
  .delve-chip:hover,
  .delve-x:hover,
  .delve-btn:hover,
  .delve-btn:focus-visible,
  .delve-recipe.is-ready:hover { --bv-hi: #fff4c0; --bv-lo: #a83a10; }
  .delve-kbd {
    font-family: var(--pixel);
    font-size: 8px;
    color: #d8ba76;
  }
  .delve-keys--touch { display: none; }
  /* 觸控裝置：不顯示鍵盤提示 */
  @media (pointer: coarse) {
    .delve-kbd,
    .delve-keys { display: none; }
    .delve-keys.delve-keys--touch { display: block; }
  }
  .delve[data-touch='1'] .delve-kbd { display: none; }

  .delve-panel {
    position: absolute;
    top: calc(var(--px) * 22 + 68px);
    left: 10px;
    width: min(480px, calc(100vw - 20px));
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    padding: 12px;
  }
  .delve-panel h2 { margin: 0; font-size: 16px; font-weight: 400; color: var(--gold); text-shadow: var(--text-outline); }
  .delve-panel-head { display: flex; justify-content: space-between; align-items: center; }
  .delve-x { width: 32px; height: 32px; padding: 0; font-family: var(--pixel); font-size: 16px; cursor: pointer; }
  .delve-hint { margin: 8px 0; font-size: 16px; line-height: 1.5; color: #d8ba76; }
  .delve-inv-grid { display: grid; grid-template-columns: repeat(10, 1fr); gap: calc(var(--px) * 2); }
  .delve-inv-grid .delve-slot { width: 100%; height: auto; aspect-ratio: 1; }
  .delve-craft-title { margin-top: 14px; }
  .delve-panel--chest { width: min(480px, calc(100vw - 20px)); }
  .delve-chest-takeall { margin-top: 10px; width: 100%; }
  /* 箱子面板：寬螢幕放在背包右邊，窄螢幕疊在背包上方 */
  @media (min-width: 1000px) {
    .delve-panel--chest { left: calc(min(480px, 100vw - 20px) + 22px); }
  }
  @media (max-width: 999px) {
    .delve[data-chest='1'] .delve-panel--chest { z-index: 5; }
  }
  .delve-chip--zoom { padding: 6px 8px; }
  .delve-loading {
    position: absolute;
    inset: 0;
    z-index: 45;
    display: grid;
    place-items: center;
    background: #120c08;
  }
  .delve-loading-text { margin: 0; font-size: 16px; color: var(--gold); text-align: center; text-shadow: var(--text-outline); }
  .delve-recipes { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .delve-recipe {
    width: 100%;
    display: grid;
    grid-template-columns: 36px 1fr;
    grid-template-rows: auto auto;
    column-gap: 8px;
    row-gap: 4px;
    align-items: center;
    padding: 6px;
    --bv-hi: #472819;
    --bv-bg: #2a1810;
    --bv-lo: #1c1424;
    color: #966139;
    text-align: left;
    cursor: pointer;
  }
  .delve-recipe .delve-slot-icon { grid-row: span 2; width: 32px; height: 32px; }
  .delve-recipe.is-ready { --bv-hi: #966139; --bv-bg: #472819; --bv-lo: #2a1810; color: var(--ink); }
  .delve-recipe:disabled { cursor: not-allowed; }
  .delve-recipe:disabled .delve-slot-icon { filter: grayscale(1) brightness(0.6); }
  .delve-recipe-name { font-size: 16px; }
  .delve-recipe-need { font-size: 16px; color: #b07a4b; line-height: 1.25; }
  .delve-recipe.is-ready .delve-recipe-need { color: #d8ba76; }

  .delve-toast {
    position: absolute;
    left: 50%;
    bottom: 26px;
    transform: translate(-50%, 12px);
    padding: 8px 12px;
    font-size: 16px;
    opacity: 0;
    transition: opacity 0.2s steps(2), transform 0.2s steps(2);
  }
  .delve-toast.is-on { opacity: 1; transform: translate(-50%, 0); }

  /* ── 觸控按鍵（粗指標或首次觸控後顯示） ── */
  .delve-touch { display: none; }
  .delve[data-touch='1'] .delve-touch { display: block; }
  @media (pointer: coarse) {
    .delve-touch { display: block; }
  }
  .delve-joy {
    --kx: 0px;
    --ky: 0px;
    position: absolute;
    left: 22px;
    bottom: 28px;
    width: 128px;
    height: 128px;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.28);
    background: rgba(0, 0, 0, 0.28);
    touch-action: none;
  }
  .delve-joy-knob {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 52px;
    height: 52px;
    margin: -26px 0 0 -26px;
    border-radius: 50%;
    background: rgba(255, 220, 150, 0.55);
    border: 3px solid rgba(255, 255, 255, 0.5);
    transform: translate(var(--kx), var(--ky));
  }
  .delve-jump {
    position: absolute;
    right: 26px;
    bottom: 44px;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.4);
    background: rgba(255, 204, 85, 0.35);
    font-size: 16px;
    touch-action: none;
  }

  /* ── 選單 ── */
  .delve-menu {
    position: absolute;
    inset: 0;
    z-index: 20;
    display: grid;
    place-items: center;
    background: rgba(5, 3, 2, 0.6);
  }
  .delve-menu-box {
    width: min(340px, calc(100vw - 32px));
    padding: 18px;
    display: grid;
    gap: 10px;
    --bv-bg: #2a1810;
  }
  .delve-menu-box h2 { margin: 0 0 6px; font-size: 16px; font-weight: 400; color: var(--gold); text-align: center; text-shadow: var(--text-outline); }
  .delve-btn {
    display: block;
    padding: 10px 14px;
    font-size: 16px;
    text-align: center;
    text-decoration: none;
    color: var(--ink);
    cursor: pointer;
  }
  .delve-btn--main { --bv-hi: #ffd86a; --bv-bg: #a83a10; --bv-lo: #6c1e14; color: #ffffff; text-shadow: var(--text-outline); }
  .delve-btn--ghost { --bv-bg: #1c1424; }
  .delve-msg { min-height: 1.2em; margin: 4px 0 0; font-size: 16px; color: #93cc50; line-height: 1.4; }
  .delve-note { margin: 4px 0 0; font-size: 16px; line-height: 1.5; color: #b07a4b; }

  /* ── 操作說明（第一次進遊戲 / 選單「操作說明」） ── */
  .delve-help {
    position: absolute;
    inset: 0;
    z-index: 30;
    display: grid;
    place-items: center;
    padding: 16px;
    background: rgba(5, 3, 2, 0.6);
  }
  .delve-help-box { width: min(420px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); overflow-y: auto; }
  .delve-help-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .delve-help-list li { display: flex; align-items: center; gap: 8px; font-size: 16px; line-height: 1.4; color: var(--ink); }
  .delve-help-list li > span:last-child { flex: 1; }
  .delve-help-key {
    flex: none;
    min-width: 28px;
    padding: 3px 6px;
    font-family: var(--pixel);
    font-size: 10px;
    text-align: center;
    color: var(--gold);
    background: #1c1424;
    border: 2px solid #7c4c2e;
  }
  .delve-help-list--touch { display: none; }
  @media (pointer: coarse) {
    .delve-help-list--keys { display: none; }
    .delve-help-list--touch { display: grid; }
  }
  .delve[data-touch='1'] .delve-help-list--keys { display: none; }
  .delve[data-touch='1'] .delve-help-list--touch { display: grid; }

  /* ── 覆蓋確認 ── */
  .delve-confirm {
    position: absolute;
    inset: 0;
    z-index: 40;
    display: grid;
    place-items: center;
    padding: 16px;
    background: rgba(5, 3, 2, 0.72);
  }
  .delve-confirm-msg { margin: 0; font-size: 16px; line-height: 1.5; color: var(--ink); }
  .delve-confirm-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 6px; }
  .delve-btn--danger { --bv-hi: #e8701c; --bv-bg: #6c1e14; --bv-lo: #1c1424; }
  .delve-btn--danger:hover,
  .delve-btn--danger:focus-visible { --bv-hi: #fff4c0; --bv-bg: #a83a10; }

  /* ── 標題 ── */
  .delve-title {
    position: absolute;
    inset: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
    overflow-y: auto;
    text-align: center;
    background:
      linear-gradient(180deg, rgba(10, 8, 20, 0.35), rgba(18, 12, 8, 0.92) 70%),
      url('/assets/games/delve/card-delve.webp') center 40% / cover no-repeat,
      #120c08;
  }
  .delve-home {
    position: absolute;
    top: 14px;
    left: 14px;
    font-family: var(--pixel);
    font-size: 8px;
    color: #d8ba76;
    text-decoration: none;
  }
  .delve-home:hover { color: var(--gold); }
  .delve-title-fg { max-width: 560px; display: grid; gap: 12px; justify-items: center; }
  .delve-logo {
    margin: 0;
    font-family: var(--pixel);
    font-size: 64px;
    font-weight: 400;
    letter-spacing: 8px;
    color: var(--gold);
    text-shadow: 4px 4px 0 #a83a10, 8px 8px 0 var(--outline);
  }
  .delve-logo small { display: block; margin-top: 16px; font-family: var(--cjk); font-size: 32px; letter-spacing: 16px; color: var(--ink); }
  .delve-tagline { margin: 0; font-family: var(--pixel); font-size: 8px; color: #c2e478; letter-spacing: 4px; text-shadow: var(--text-outline); }
  .delve-story { margin: 0; font-size: 16px; line-height: 1.6; color: var(--ink); text-shadow: var(--text-outline); }
  .delve-seed { display: flex; gap: 10px; align-items: center; font-size: 16px; color: #d8ba76; }
  .delve-seed input {
    width: 180px;
    padding: 6px 8px;
    font: inherit;
    font-size: 16px;
    color: var(--ink);
    --bv-hi: #1c1424;
    --bv-lo: #966139;
    --bv-bg: #1c1424;
  }
  .delve-title-btns { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .delve-keys { margin: 0; font-size: 16px; line-height: 1.6; color: #d8ba76; text-shadow: var(--text-outline); }

  /* ── 小地圖（右上，角落按鈕下方）：原生 120×80 美術像素，整數倍放大 ── */
  .delve-minimap {
    --mm: var(--px);
    position: absolute;
    top: 58px;
    right: 10px;
    display: grid;
    gap: 4px;
    justify-items: end;
  }
  .delve[data-px='3'] .delve-minimap { --mm: 2px; }
  .delve-minimap-canvas {
    width: calc(var(--mm) * 120);
    height: calc(var(--mm) * 80);
    image-rendering: pixelated;
    cursor: pointer;
    border: var(--px) solid;
    border-color: var(--bv-hi) var(--bv-lo) var(--bv-lo) var(--bv-hi);
    box-shadow: 0 0 0 var(--px) var(--outline);
    background: #0c0a12;
  }
  .delve-minimap-btns { display: flex; gap: 4px; align-items: center; }
  .delve-mm-label { font-size: 16px; color: #d8ba76; text-shadow: var(--text-outline); display: flex; gap: 4px; align-items: center; }
  .delve-mm-btn {
    width: 28px;
    height: 24px;
    padding: 0;
    font-size: 16px;
    cursor: pointer;
    border: var(--px) solid;
    border-color: var(--bv-hi) var(--bv-lo) var(--bv-lo) var(--bv-hi);
    background: var(--bv-bg);
    box-shadow: 0 0 0 var(--px) var(--outline);
  }
  .delve-mm-btn:hover { --bv-hi: #fff4c0; --bv-lo: #a83a10; }

  /* ── 發現橫幅：上方置中，像素外框 + 金字；進場 / 退場用 steps() ── */
  .delve-banner {
    position: absolute;
    top: 22%;
    left: 50%;
    display: grid;
    gap: 2px;
    justify-items: center;
    min-width: min(360px, calc(100vw - 32px));
    padding: 10px 22px 12px;
    border: calc(var(--px) * 2) solid;
    border-color: #ffd86a #6c1e14 #6c1e14 #ffd86a;
    background: #2a1810;
    box-shadow: 0 0 0 var(--px) var(--outline), calc(var(--px) * 3) calc(var(--px) * 3) 0 0 var(--outline);
    transform: translate(-50%, -16px);
    opacity: 0;
    transition: opacity 0.3s steps(3), transform 0.3s steps(3);
    pointer-events: none;
  }
  .delve-banner.is-on { opacity: 1; transform: translate(-50%, 0); }
  .delve-banner-sub { font-size: 16px; color: #d8ba76; letter-spacing: 4px; }
  .delve-banner-title { font-size: 32px; line-height: 1.1; color: var(--gold); text-shadow: 2px 2px 0 #a83a10, var(--text-outline); }

  /* ── 碑文：石碑色的面板 ── */
  .delve-lore {
    position: absolute;
    left: 50%;
    bottom: 90px;
    width: min(520px, calc(100vw - 24px));
    transform: translateX(-50%);
    z-index: 6;
  }
  .delve-lore-box {
    display: grid;
    gap: 8px;
    padding: 14px 18px;
    border: calc(var(--px) * 2) solid;
    border-color: #b4b9c8 #2c2838 #2c2838 #b4b9c8;
    background: #423f54;
    box-shadow: 0 0 0 var(--px) var(--outline), calc(var(--px) * 3) calc(var(--px) * 3) 0 0 var(--outline);
  }
  .delve-lore-kicker { margin: 0; font-size: 16px; color: #a2c8b0; }
  .delve-lore-title { margin: 0; font-size: 16px; font-weight: 400; color: #fff4c0; text-shadow: var(--text-outline); }
  .delve-lore-text { margin: 0; font-size: 16px; line-height: 1.7; color: var(--ink); text-shadow: var(--text-outline); }
  .delve-lore-close { justify-self: end; padding: 6px 14px; }

  /* ── 探險日誌（右側面板） ── */
  .delve-panel--journal { left: auto; right: 10px; width: min(440px, calc(100vw - 20px)); }
  .delve-journal-body { display: grid; gap: 10px; margin-top: 8px; }
  .delve-j-top { display: grid; gap: 6px; }
  .delve-j-big { font-size: 16px; color: var(--gold); text-shadow: var(--text-outline); }
  .delve-j-facts { margin: 0; font-size: 16px; color: #d8ba76; }
  .delve-seg { display: flex; gap: var(--px); }
  .delve-seg-cell { width: calc(var(--px) * 6); height: calc(var(--px) * 5); background: #1c1424; box-shadow: inset 0 0 0 var(--px) #2a1810; }
  .delve-seg-cell.is-on { background: #93cc50; box-shadow: inset 0 calc(var(--px) * -1) 0 0 #468a34, inset 0 var(--px) 0 0 #c2e478; }
  .delve-j-cats { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .delve-j-cat-head { display: flex; gap: 8px; align-items: center; }
  .delve-j-cat-name { min-width: 6em; font-size: 16px; color: var(--ink); }
  .delve-j-count { min-width: 4em; font-size: 16px; color: var(--gold); }
  .delve-j-names { margin: 2px 0 0; font-size: 16px; line-height: 1.4; color: #b07a4b; }
  .delve-j-h { margin: 4px 0 0; font-size: 16px; font-weight: 400; color: var(--gold); text-shadow: var(--text-outline); }
  .delve-j-lore { margin: 0; padding-left: 2em; display: grid; grid-template-columns: 1fr 1fr; gap: 2px 10px; font-size: 16px; color: #966139; }
  .delve-j-lore-btn { padding: 0; border: 0; background: none; font-size: 16px; color: #cceaf8; cursor: pointer; text-align: left; }
  .delve-j-lore-btn:hover { color: #fff4c0; }
  .delve-j-unknown { color: #623924; }
  .delve-j-treasures { display: flex; flex-wrap: wrap; gap: 6px; }
  .delve-j-treasure { display: grid; place-items: center; width: calc(var(--px) * 20); height: calc(var(--px) * 20); background: #1c1424; box-shadow: 0 0 0 var(--px) #472819; }
  .delve-j-treasure .delve-slot-icon { filter: brightness(0); opacity: 0.6; }
  .delve-j-treasure.is-got { background: #472819; box-shadow: 0 0 0 var(--px) #ffd86a; }
  .delve-j-treasure.is-got .delve-slot-icon { filter: none; opacity: 1; }

  /* ── 全地圖 ── */
  .delve-map { position: absolute; inset: 0; z-index: 15; background: #0c0a12; }
  .delve-map-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; image-rendering: pixelated; touch-action: none; cursor: grab; }
  .delve-map-head {
    position: absolute;
    top: 10px;
    left: 10px;
    right: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    align-items: center;
    pointer-events: none;
  }
  .delve-map-head > * { pointer-events: auto; }
  .delve-map-head h2 { margin: 0; font-size: 16px; font-weight: 400; color: var(--gold); text-shadow: var(--text-outline); }
  .delve-map-info { margin: 0; flex: 1; font-size: 16px; color: #d8ba76; text-shadow: var(--text-outline); }
  .delve-map-btns { display: flex; gap: 6px; }
  .delve-map-help {
    position: absolute;
    left: 50%;
    bottom: 14px;
    margin: 0;
    transform: translateX(-50%);
    font-size: 16px;
    color: #d8ba76;
    text-shadow: var(--text-outline);
    white-space: nowrap;
    pointer-events: none;
  }
  .delve[data-map='1'] .delve-touch { display: none; }


  /* ── 生命 / 魔力（上方置中）、首領血條、死亡畫面、道具說明 ── */
  .delve-vitals {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: 2px;
    pointer-events: none;
  }
  .delve-hearts { height: calc(var(--px) * 11); width: auto; image-rendering: pixelated; }
  .delve-hearts[data-rows='2'] { height: calc(var(--px) * 20); }
  .delve-hp-text { font-family: var(--pixel); font-size: 8px; color: #fff4c0; text-shadow: var(--text-outline); }
  .delve-mana { width: calc(var(--px) * 41); height: calc(var(--px) * 5); image-rendering: pixelated; }
  .delve-boss {
    position: absolute;
    left: 50%;
    bottom: 70px;
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: 4px;
    pointer-events: none;
  }
  .delve-boss-name { font-size: 16px; color: #cceaf8; text-shadow: var(--text-outline); }
  .delve-boss-bar { width: calc(var(--px) * 160); height: calc(var(--px) * 8); image-rendering: pixelated; }
  .delve-death {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 10px;
    text-align: center;
    background: rgba(44, 8, 6, 0.45);
    pointer-events: none;
    z-index: 8;
  }
  .delve-death-title { margin: 0; font-size: 32px; color: #e8701c; text-shadow: 3px 3px 0 #6c1e14, var(--text-outline); letter-spacing: 6px; }
  .delve-death-msg { margin: 0; font-size: 16px; color: #f2e2b0; text-shadow: var(--text-outline); }
  .delve-tip {
    --tx: 0px;
    --ty: 0px;
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(var(--tx), var(--ty));
    z-index: 12;
    max-width: min(320px, calc(100vw - 24px));
    padding: 6px 10px;
    border: var(--px) solid;
    border-color: #b4b9c8 #1c1424 #1c1424 #b4b9c8;
    background: #18204a;
    box-shadow: 0 0 0 var(--px) var(--outline);
    pointer-events: none;
  }
  .delve-tip p { margin: 0; font-size: 16px; line-height: 1.35; color: #cceaf8; }
  .delve-tip .delve-tip-name { color: #ffd86a; text-shadow: var(--text-outline); }
  .delve-equip-row { display: flex; gap: 8px; align-items: center; }
  .delve-equip { display: grid; grid-template-columns: repeat(8, calc(var(--px) * 20)); gap: calc(var(--px) * 2); }
  .delve-equip .delve-slot { width: calc(var(--px) * 20); height: calc(var(--px) * 20); }
  .delve-slot--armor { --bv-bg: #1c1424; }
  .delve-slot--acc { --bv-bg: #18204a; }
  .delve-slot-label { position: absolute; left: 2px; top: 1px; font-size: 16px; line-height: 16px; color: #472819; }
  .delve-slot--acc .delve-slot-label { color: #2c4486; }
  .delve-slot.is-filled .delve-slot-label { display: none; }
  .delve-equip-btn { padding: 6px 10px; }
  .delve-stats { color: #cceaf8; }
  .delve-chip--aim[aria-pressed='true'] { --bv-hi: #cceaf8; --bv-bg: #1f6474; --bv-lo: #18204a; }
  .delve[data-boss='1'] .delve-toast { bottom: 110px; }

  @media (max-width: 640px) {
    .delve-hotbar { gap: 2px; left: 6px; top: 6px; }
    .delve-slot { --px: 2px; width: 36px; height: 36px; }
    .delve-slot-icon { width: 16px; height: 16px; }
    .delve-hotbar .delve-slot-icon { width: 32px; height: 32px; }
    .delve-slot-key { display: none; }
    .delve-logo { font-size: 32px; }
    /* 背包 / 選單移到右上角（快捷欄下方一列），不擋畫面中右側 */
    .delve-corner { top: 46px; right: 6px; gap: 4px; }
    .delve-chip { padding: 4px 8px; }
    .delve-held { top: 48px; left: 8px; }
    .delve-status { top: 70px; left: 8px; }
    /* 背包面板在角落按鈕與狀態列下方，不覆蓋它們 */
    .delve-panel { top: 100px; left: 6px; width: calc(100vw - 12px); max-height: calc(100vh - 260px); }
    .delve-corner { left: 6px; justify-content: flex-end; flex-wrap: wrap; }
    .delve-chip { gap: 2px; padding: 4px 6px; }
    .delve-chip--zoom { padding: 4px 6px; }
    .delve-held { top: 84px; }
    .delve-status { top: 106px; max-width: calc(100vw - 150px); line-height: 1.3; }
    .delve-minimap { top: 84px; right: 6px; }
    .delve-panel { top: 196px; max-height: calc(100vh - 360px); }
    .delve-panel--journal { left: 6px; right: 6px; width: auto; }
    .delve-banner { top: 30%; padding: 8px 12px; }
    .delve-banner-title { font-size: 16px; }
    .delve-lore { bottom: 200px; }
    .delve-map-help { white-space: normal; width: calc(100vw - 24px); text-align: center; bottom: 10px; }
    .delve-map-info { flex-basis: 100%; order: 3; }
